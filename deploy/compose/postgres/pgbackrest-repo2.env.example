#
# pgBackRest repo2: the "second site" of spec §10 (backups and WAL archive
# off this host). Copy to deploy/compose/.env.pgbackrest (git-ignored) and
# uncomment ONE block. `postgres` (archive-push) and `backup` (backups,
# expiry) read it through `env_file`; pgBackRest then archives every WAL
# segment and writes every backup to repo1 AND repo2. Then:
#
#   1. Secrets: never put them in this file (it ends up in `docker inspect`).
#      Create Docker secrets named pgbackrest_<option> (e.g.
#      secrets/pgbackrest_repo2_cipher_pass, openssl rand -base64 48), and
#      uncomment them in compose.yaml (top-level `secrets:` and the `secrets:`
#      of `postgres` and `backup`). The wrapper postgres/bin/pgbackrest turns
#      /run/secrets/pgbackrest_repo2_cipher_pass into repo2-cipher-pass.
#   2. Network: the `backend` network has no outbound access. Add `egress` to
#      the networks of `postgres` and replace `network_mode: none` of `backup`
#      by `networks: [egress]` (comments in compose.yaml).
#   3. docker compose --profile backup up -d   (recreates postgres and backup)
#      docker compose exec backup pgbackrest --stanza=oecp stanza-create
#      docker compose exec backup pgbackrest --stanza=oecp check
#      docker compose exec backup oecp-backup backup full     # first full on repo2
#   4. Drill from the second site:
#      scripts/restore-drill.sh --repo 2 --env-file .env.pgbackrest
#      (it mounts secrets/pgbackrest_* and secrets/pgbackrest-* like compose.yaml)
#
# Always encrypt repo2 (the cipher cannot be changed once the stanza exists):
# the backups hold personal data, password hashes and TOTP secrets. Keep the
# passphrase with the offline copy of the other secrets (runbook §2): without
# it repo2 cannot be restored.

# --- S3 or S3-compatible (MinIO, Ceph RGW, institutional object storage) -------
# PGBACKREST_REPO2_TYPE=s3
# PGBACKREST_REPO2_PATH=/oecp
# PGBACKREST_REPO2_S3_BUCKET=oecp-backups
# PGBACKREST_REPO2_S3_ENDPOINT=s3.eu-west-1.amazonaws.com
# PGBACKREST_REPO2_S3_REGION=eu-west-1
# PGBACKREST_REPO2_S3_KEY=AKIA...
#   (key secret: Docker secret pgbackrest_repo2_s3_key_secret)
# MinIO and most on-premises stores: path-style URLs, and the CA if private.
# PGBACKREST_REPO2_S3_URI_STYLE=path
# PGBACKREST_REPO2_STORAGE_CA_FILE=/run/secrets/pgbackrest-repo2-ca.crt
# PGBACKREST_REPO2_CIPHER_TYPE=aes-256-cbc
#   (passphrase: Docker secret pgbackrest_repo2_cipher_pass)
# PGBACKREST_REPO2_RETENTION_FULL_TYPE=time
# PGBACKREST_REPO2_RETENTION_FULL=35
# PGBACKREST_REPO2_BUNDLE=y
# PGBACKREST_REPO2_BLOCK=y

# --- SFTP (an SSH server at the second site) -----------------------------------
# PGBACKREST_REPO2_TYPE=sftp
# PGBACKREST_REPO2_PATH=/srv/pgbackrest/oecp
# PGBACKREST_REPO2_SFTP_HOST=backup.example.org
# PGBACKREST_REPO2_SFTP_HOST_USER=oecp-backup
# Private key (not named pgbackrest_*: it is a file path, not a value):
# mount it as a Docker secret `pgbackrest-repo2-sftp-key` (mode 0600, readable by uid 999).
# PGBACKREST_REPO2_SFTP_PRIVATE_KEY_FILE=/run/secrets/pgbackrest-repo2-sftp-key
# Pin the server's host key (ssh-keyscan backup.example.org | ssh-keygen -lf - -E sha1).
# PGBACKREST_REPO2_SFTP_HOST_KEY_HASH_TYPE=sha1
# PGBACKREST_REPO2_SFTP_HOST_FINGERPRINT=<hex fingerprint>
# PGBACKREST_REPO2_CIPHER_TYPE=aes-256-cbc
# PGBACKREST_REPO2_RETENTION_FULL_TYPE=time
# PGBACKREST_REPO2_RETENTION_FULL=35
# PGBACKREST_REPO2_BUNDLE=y
# PGBACKREST_REPO2_BLOCK=y

# The uploads archives (repo1 uploads/uploads-YYYY-MM-DD.tar.gz) are not
# pgBackRest data and are NOT copied to repo2: copy that directory of the
# `pgbackrest-repo` volume to the second site with your file-transfer tooling.
