{
  "name": "@oecp/schemas",
  "version": "0.4.0",
  "private": true,
  "description": "Canonical model, CSV template and error contract schemas for OECP",
  "license": "EUPL-1.2",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors.json": "./errors.json",
    "./json/*": "./json/*"
  },
  "files": [
    "dist",
    "json",
    "errors.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/generate-json.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
