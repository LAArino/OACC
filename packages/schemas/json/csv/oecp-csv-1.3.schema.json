{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oecp:schema:csv:1.3",
  "title": "OECP CSV template 1.3 (accepts 1.0, 1.1 and 1.2)",
  "$defs": {
    "courseRow": {
      "type": "object",
      "properties": {
        "template_version": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^1\\.[0-3]$"
        },
        "course_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"
        },
        "status": {
          "type": "string",
          "maxLength": 20000,
          "$ref": "urn:oecp:schema:canonical:1#/$defs/lifecycleStatus"
        },
        "ects": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "^\\d{1,3}(\\.\\d{1,2})?$"
        },
        "isced_codes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "^\\d{2,6}(\\|\\d{2,6})*$"
        },
        "title_en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "^[\\s\\S]{1,500}$"
        },
        "kind": {
          "type": "string",
          "maxLength": 20000,
          "anyOf": [
            {
              "const": ""
            },
            {
              "$ref": "urn:oecp:schema:canonical:1#/$defs/courseKind"
            }
          ]
        },
        "levels": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^(?:|(short_cycle|bachelor|master|doctoral|other)(\\|(short_cycle|bachelor|master|doctoral|other))*)$"
        },
        "level": {
          "type": "string",
          "maxLength": 20000,
          "anyOf": [
            {
              "const": ""
            },
            {
              "$ref": "urn:oecp:schema:canonical:1#/$defs/courseLevel"
            }
          ]
        },
        "eqf_level": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^(?:|[1-8])$"
        },
        "teaching_hours": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^(?:|\\d{1,5}(\\.\\d)?)$"
        },
        "teaching_unit_code": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^(?:|[A-Za-z0-9][A-Za-z0-9._/-]{0,199})$"
        },
        "info_url": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^(?:|https:\\/\\/[^\\s/?#]+[^\\s]*)$"
        },
        "contact_email": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^(?:|[^@\\s]+@[^@\\s]+\\.[^@\\s]+)$"
        },
        "instructors": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^(?:|[^|]+(\\|[^|]+)*)$"
        },
        "image_url": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^(?:|https:\\/\\/[^\\s/?#]+[^\\s]*)$"
        },
        "image_alt_en": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^(?:|[\\s\\S]{1,300})$"
        },
        "image_credit": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^(?:|[\\s\\S]{1,300})$"
        }
      },
      "required": [
        "template_version",
        "course_code",
        "status",
        "ects",
        "isced_codes",
        "title_en"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(title|abstract|description|learning_outcomes|prerequisites|assessment|mode_of_repetition|methods|literature|privacy_notice|remarks|keywords)_([a-z]{2,3})$": {
          "type": "string",
          "maxLength": 20000
        },
        "^attr_([a-z][a-z0-9_]{1,39})$": {
          "type": "string",
          "maxLength": 20000
        }
      }
    },
    "offeringRow": {
      "type": "object",
      "properties": {
        "template_version": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^1\\.[0-3]$"
        },
        "course_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"
        },
        "offering_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"
        },
        "status": {
          "type": "string",
          "maxLength": 20000,
          "$ref": "urn:oecp:schema:canonical:1#/$defs/lifecycleStatus"
        },
        "start_date": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "$ref": "urn:oecp:schema:canonical:1#/$defs/isoDate"
        },
        "end_date": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "$ref": "urn:oecp:schema:canonical:1#/$defs/isoDate"
        },
        "teaching_languages": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{1,8})*(\\|[a-z]{2,3}(-[A-Za-z0-9]{1,8})*)*$"
        },
        "delivery_modes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "^(x-)?[a-z][a-z0-9_-]*(\\|(x-)?[a-z][a-z0-9_-]*)*$"
        },
        "academic_session_code": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^(?:|[A-Za-z0-9][A-Za-z0-9._/-]{0,199})$"
        },
        "enrol_start_date": {
          "type": "string",
          "maxLength": 20000,
          "anyOf": [
            {
              "const": ""
            },
            {
              "$ref": "urn:oecp:schema:canonical:1#/$defs/isoDate"
            }
          ]
        },
        "application_deadline": {
          "type": "string",
          "maxLength": 20000,
          "anyOf": [
            {
              "const": ""
            },
            {
              "$ref": "urn:oecp:schema:canonical:1#/$defs/isoDate"
            }
          ]
        },
        "timezone": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^(?:|[A-Za-z][A-Za-z0-9_+-]*(\\/[A-Za-z0-9_+-]+)*)$"
        },
        "campus": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^(?:|[\\s\\S]{1,200})$"
        },
        "max_students": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^(?:|[1-9]\\d{0,8})$"
        },
        "alliance_seats": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^(?:|\\d{1,9})$"
        },
        "seats_available": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^(?:|\\d{1,9})$"
        },
        "application_url": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^(?:|https:\\/\\/[^\\s/?#]+[^\\s]*)$"
        }
      },
      "required": [
        "template_version",
        "course_code",
        "offering_code",
        "status",
        "start_date",
        "end_date",
        "teaching_languages",
        "delivery_modes"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^application_instructions_([a-z]{2,3})$": {
          "type": "string",
          "maxLength": 20000
        }
      }
    },
    "oecp-canonical-1": {
      "$id": "urn:oecp:schema:canonical:1",
      "title": "OECP canonical model 1",
      "$defs": {
        "organization": {
          "type": "object",
          "properties": {
            "parent_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "org_type": {
              "type": "string",
              "enum": [
                "alliance",
                "institution",
                "faculty",
                "department",
                "campus",
                "other"
              ]
            },
            "is_partner": {
              "default": false,
              "type": "boolean"
            },
            "slug": {
              "type": "string",
              "pattern": "^[a-z0-9-]{2,40}$"
            },
            "name": {
              "type": "object",
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "en"
              ],
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "schac_home_organization": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253
                },
                {
                  "type": "null"
                }
              ]
            },
            "erasmus_code": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ]
            },
            "pic": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{9}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "country_code": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "website_url": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^https:\\/\\/[^\\s/?#]+[^\\s]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "logo_url": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^https:\\/\\/[^\\s/?#]+[^\\s]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "contact_email": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 320,
                  "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "default_timezone": {
              "default": "Europe/Brussels",
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(\\/[A-Za-z0-9_+-]+)*$"
            },
            "ui_languages": {
              "default": [
                "en"
              ],
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{1,8})*$"
              }
            },
            "ext_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "keycloak_idp_alias": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "org_type",
            "slug",
            "name"
          ]
        },
        "deliveryMode": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^(x-)?[a-z][a-z0-9_-]*$"
            },
            "label": {
              "type": "object",
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "en"
              ],
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "schema_org": {
              "type": "string",
              "enum": [
                "Onsite",
                "Online",
                "Blended"
              ]
            },
            "sort_order": {
              "default": 0,
              "type": "integer",
              "minimum": -32768,
              "maximum": 32767
            },
            "active": {
              "default": true,
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "label",
            "schema_org"
          ]
        },
        "academicSession": {
          "type": "object",
          "properties": {
            "ext_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "parent_ext_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "session_type": {
              "type": "string",
              "enum": [
                "academic_year",
                "semester",
                "trimester",
                "quarter",
                "testing_period",
                "period"
              ]
            },
            "name": {
              "type": "object",
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "en"
              ],
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "start_date": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            "end_date": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            }
          },
          "required": [
            "ext_id",
            "session_type",
            "name",
            "start_date",
            "end_date"
          ]
        },
        "course": {
          "type": "object",
          "properties": {
            "ext_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "source_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "published",
                "withdrawn",
                "cancelled"
              ]
            },
            "kind": {
              "default": "course",
              "type": "string",
              "enum": [
                "course",
                "bip",
                "lecture_series",
                "other"
              ]
            },
            "ects": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 120
            },
            "level": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "short_cycle",
                    "bachelor",
                    "master",
                    "doctoral",
                    "other"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "levels": {
              "default": [],
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "short_cycle",
                  "bachelor",
                  "master",
                  "doctoral",
                  "other"
                ]
              }
            },
            "eqf_level": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                },
                {
                  "type": "null"
                }
              ]
            },
            "teaching_hours": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 99999.9
                },
                {
                  "type": "null"
                }
              ]
            },
            "teaching_unit_ext_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "info_url": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^https:\\/\\/[^\\s/?#]+[^\\s]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "contact_email": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 320,
                  "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "isced_codes": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\d{2,6}$"
              }
            },
            "instructors": {
              "default": [],
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "texts": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z]{2,3}$"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "abstract": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "learning_outcomes": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "prerequisites": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "assessment": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "mode_of_repetition": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "methods": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "literature": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "privacy_notice": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "remarks": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "keywords": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "is_machine_translated": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "title"
                ]
              }
            },
            "attributes": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,39}$"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  {
                    "minItems": 1,
                    "maxItems": 200,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "ext_id",
            "status",
            "ects",
            "texts"
          ]
        },
        "courseText": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "abstract": {
              "type": [
                "string",
                "null"
              ]
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "learning_outcomes": {
              "type": [
                "string",
                "null"
              ]
            },
            "prerequisites": {
              "type": [
                "string",
                "null"
              ]
            },
            "assessment": {
              "type": [
                "string",
                "null"
              ]
            },
            "mode_of_repetition": {
              "type": [
                "string",
                "null"
              ]
            },
            "methods": {
              "type": [
                "string",
                "null"
              ]
            },
            "literature": {
              "type": [
                "string",
                "null"
              ]
            },
            "privacy_notice": {
              "type": [
                "string",
                "null"
              ]
            },
            "remarks": {
              "type": [
                "string",
                "null"
              ]
            },
            "keywords": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "is_machine_translated": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "title"
          ]
        },
        "courseOffering": {
          "type": "object",
          "properties": {
            "course_ext_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "ext_offering_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "source_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "published",
                "withdrawn",
                "cancelled"
              ]
            },
            "academic_session_ext_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "start_date": {
              "type": "string",
              "format": "date",
