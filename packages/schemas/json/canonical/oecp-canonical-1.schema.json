{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oecp:schema:canonical:1",
  "title": "OECP canonical model 1",
  "$defs": {
    "organization": {
      "type": "object",
      "properties": {
        "parent_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "org_type": {
          "type": "string",
          "enum": [
            "alliance",
            "institution",
            "faculty",
            "department",
            "campus",
            "other"
          ]
        },
        "is_partner": {
          "default": false,
          "type": "boolean"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,40}$"
        },
        "name": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "en"
          ],
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "schac_home_organization": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            {
              "type": "null"
            }
          ]
        },
        "erasmus_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "pic": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{9}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "country_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "website_url": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^https:\\/\\/[^\\s/?#]+[^\\s]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "logo_url": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^https:\\/\\/[^\\s/?#]+[^\\s]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "contact_email": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 320,
              "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "default_timezone": {
          "default": "Europe/Brussels",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(\\/[A-Za-z0-9_+-]+)*$"
        },
        "ui_languages": {
          "default": [
            "en"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{1,8})*$"
          }
        },
        "ext_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "keycloak_idp_alias": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "org_type",
        "slug",
        "name"
      ]
    },
    "deliveryMode": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^(x-)?[a-z][a-z0-9_-]*$"
        },
        "label": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "en"
          ],
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "schema_org": {
          "type": "string",
          "enum": [
            "Onsite",
            "Online",
            "Blended"
          ]
        },
        "sort_order": {
          "default": 0,
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        },
        "active": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "label",
        "schema_org"
      ]
    },
    "academicSession": {
      "type": "object",
      "properties": {
        "ext_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "parent_ext_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "session_type": {
          "type": "string",
          "enum": [
            "academic_year",
            "semester",
            "trimester",
            "quarter",
            "testing_period",
            "period"
          ]
        },
        "name": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "en"
          ],
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "start_date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "end_date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        }
      },
      "required": [
        "ext_id",
        "session_type",
        "name",
        "start_date",
        "end_date"
      ]
    },
    "course": {
      "type": "object",
      "properties": {
        "ext_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "published",
            "withdrawn",
            "cancelled"
          ]
        },
        "kind": {
          "default": "course",
          "type": "string",
          "enum": [
            "course",
            "bip",
            "lecture_series",
            "other"
          ]
        },
        "ects": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "level": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "short_cycle",
                "bachelor",
                "master",
                "doctoral",
                "other"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "levels": {
          "default": [],
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "short_cycle",
              "bachelor",
              "master",
              "doctoral",
              "other"
            ]
          }
        },
        "eqf_level": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            {
              "type": "null"
            }
          ]
        },
        "teaching_hours": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 99999.9
            },
            {
              "type": "null"
            }
          ]
        },
        "teaching_unit_ext_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "info_url": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^https:\\/\\/[^\\s/?#]+[^\\s]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "contact_email": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 320,
              "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "isced_codes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{2,6}$"
          }
        },
        "texts": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "abstract": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "learning_outcomes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "prerequisites": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "assessment": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "keywords": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "is_machine_translated": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "title"
            ]
          }
        },
        "attributes": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,39}$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              {
                "minItems": 1,
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      },
      "required": [
        "ext_id",
        "status",
        "ects",
        "texts"
      ]
    },
    "courseText": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "abstract": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "learning_outcomes": {
          "type": [
            "string",
            "null"
          ]
        },
        "prerequisites": {
          "type": [
            "string",
            "null"
          ]
        },
        "assessment": {
          "type": [
            "string",
            "null"
          ]
        },
        "keywords": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "is_machine_translated": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "title"
      ]
    },
    "courseOffering": {
      "type": "object",
      "properties": {
        "course_ext_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "ext_offering_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "published",
            "withdrawn",
            "cancelled"
          ]
        },
        "academic_session_ext_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "start_date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "end_date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "enrol_start_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "application_deadline": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "timezone": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(\\/[A-Za-z0-9_+-]+)*$"
        },
        "teaching_languages": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{1,8})*$"
          }
        },
        "delivery_modes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(x-)?[a-z][a-z0-9_-]*$"
          }
        },
        "campus": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "max_students": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "alliance_seats": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "seats_available": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "seats_updated_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "application_url": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^https:\\/\\/[^\\s/?#]+[^\\s]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "application_instructions": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        }
      },
      "required": [
        "course_ext_id",
        "ext_offering_id",
        "status",
        "start_date",
        "end_date",
        "timezone",
        "teaching_languages",
        "delivery_modes"
      ]
    },
    "attributeDefinition": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,39}$"
        },
        "value_type": {
          "type": "string",
          "enum": [
            "enum",
            "multi_enum",
            "boolean",
            "text"
          ]
        },
        "label": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "en"
          ],
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "en"
              ],
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "options": {
          "default": null,
          "anyOf": [
            {
              "minItems": 1,
              "maxItems": 200,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
                  },
                  "label": {
                    "type": "object",
                    "properties": {
                      "en": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "en"
                    ],
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "value",
                  "label"
                ],
                "additionalProperties": false
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "filterable": {
          "default": false,
          "type": "boolean"
        },
        "show_as_tag": {
          "default": true,
          "type": "boolean"
        },
        "sort_order": {
          "default": 0,
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        }
      },
      "required": [
        "key",
        "value_type",
        "label"
      ],
      "additionalProperties": false
    },
    "courseAttributes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,39}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          {
            "minItems": 1,
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "languageTag": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{1,8})*$"
    },
    "iscedCode": {
      "type": "string",
      "pattern": "^\\d{2,6}$"
    }
  }
}
