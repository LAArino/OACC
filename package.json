{
  "name": "oecp",
  "version": "0.2.0",
  "private": true,
  "description": "Open European Campus Portal monorepo",
  "license": "EUPL-1.2",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^22.22.3"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @oecp/schemas build && pnpm -r typecheck",
    "format": "prettier --write \"*.{js,ts,json}\" \"apps/**/*.{ts,vue,js,mjs,json}\" \"packages/*/{src,test,scripts}/**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"*.{js,ts,json}\" \"apps/**/*.{ts,vue,js,mjs,json}\" \"packages/*/{src,test,scripts}/**/*.{ts,mjs}\"",
    "db:migrate": "pnpm --filter @oecp/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vue-eslint-parser": "10.4.1"
  }
}
