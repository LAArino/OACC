{
  "name": "@oecp/api",
  "version": "0.3.0",
  "private": true,
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "cli": "node dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "node-pg-migrate up --migrations-dir db/migrations --migrations-table pgmigrations --check-order",
    "db:migrate:down": "node-pg-migrate down --migrations-dir db/migrations --migrations-table pgmigrations",
    "db:migrate:create": "node-pg-migrate create --migrations-dir db/migrations --migration-file-language sql"
  },
  "dependencies": {
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@oecp/schemas": "workspace:*",
    "@xmldom/xmldom": "0.8.15",
    "bullmq": "6.3.13",
    "commander": "15.0.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "nestjs-pino": "5.3.1",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "10.0.12",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "saxes": "6.0.0",
    "xml-crypto": "6.3.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.4"
  }
}
